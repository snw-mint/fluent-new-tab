+// Só dispara com a permissão opcional "tabs" concedida; sem ela, info.favIconUrl não vem preenchido.
+chrome.tabs.onUpdated.addListener((_tabId, info, tab) => {
+  const icon = info.favIconUrl;
+  if (!icon || !tab.url || !/^https?:/i.test(tab.url)) return;
+  if (!/^(https?:|data:image\/)/i.test(icon) || icon.length > 200000) return;
+  try {
+    const host = new URL(tab.url).hostname;
+    chrome.storage.local.set({
+      ['faviconCache:' + host]: { src: icon, ts: Date.now(), learned: true },
+    });
+  } catch {}
+});
+
 chrome.action.onClicked.addListener(() => {
   chrome.tabs.create({});
 });

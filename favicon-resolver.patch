diff --git a/src/core/shared/favicon-resolver.ts b/src/core/shared/favicon-resolver.ts
new file mode 100644
index 0000000..1fae7e0
--- /dev/null
+++ b/src/core/shared/favicon-resolver.ts
@@ -0,0 +1,157 @@
+/*
+ * Fluent New Tab
+ * Copyright (c) 2025-2026 SnowMint
+ * Licensed under the GNU General Public License v3.0 (GPL-3.0)
+ * You should have received a copy of the GNU General Public License along with this program.
+ * If not, see <https://www.gnu.org/licenses/>.
+ */
+
+const CACHE_PREFIX = 'faviconCache:';
+const TTL = 14 * 24 * 60 * 60 * 1000;
+const LOAD_TIMEOUT = 4000;
+
+interface FaviconEntry {
+  src: string;
+  ts: number;
+  learned?: boolean;
+}
+
+const inflight = new Map<string, Promise<string | null>>();
+
+export function isLocalHost(h: string): boolean {
+  return (
+    h === 'localhost' ||
+    h === '[::1]' ||
+    !h.includes('.') ||
+    /\.(local|lan|internal|home|test)$/.test(h) ||
+    /^(127\.|10\.|192\.168\.|172\.(1[6-9]|2\d|3[01])\.)/.test(h)
+  );
+}
+
+function canLoad(src: string): Promise<boolean> {
+  return new Promise((resolve) => {
+    const img = new Image();
+    const timer = setTimeout(() => resolve(false), LOAD_TIMEOUT);
+    img.onload = () => {
+      clearTimeout(timer);
+      resolve(img.naturalWidth >= 16);
+    };
+    img.onerror = () => {
+      clearTimeout(timer);
+      resolve(false);
+    };
+    img.src = src;
+  });
+}
+
+async function readEntry(host: string): Promise<FaviconEntry | null> {
+  try {
+    const key = CACHE_PREFIX + host;
+    const data = await chrome.storage.local.get(key);
+    return (data[key] as FaviconEntry) ?? null;
+  } catch {
+    return null;
+  }
+}
+
+function writeEntry(host: string, entry: FaviconEntry): void {
+  try {
+    chrome.storage.local.set({ [CACHE_PREFIX + host]: entry });
+  } catch {}
+}
+
+const chromeFaviconUrl = (page: string) =>
+  `${chrome.runtime.getURL('/_favicon/')}?pageUrl=${encodeURIComponent(page)}&size=64`;
+
+async function sha256(blob: Blob): Promise<string> {
+  const buf = await crypto.subtle.digest('SHA-256', await blob.arrayBuffer());
+  return [...new Uint8Array(buf)]
+    .map((x) => x.toString(16).padStart(2, '0'))
+    .join('');
+}
+
+let fallbackHash: Promise<string | null> | null = null;
+
+// O endpoint _favicon do Chrome sempre responde 200; o ícone-padrão é
+// detectado comparando o hash com o de uma página que não existe.
+async function chromeIcon(pageUrl: string): Promise<string | null> {
+  if (!chrome.runtime.getManifest().permissions?.includes('favicon')) {
+    return null;
+  }
+  try {
+    fallbackHash ??= fetch(chromeFaviconUrl('https://favicon-probe.invalid/'))
+      .then((r) => r.blob())
+      .then(sha256)
+      .catch(() => null);
+    const blob = await (await fetch(chromeFaviconUrl(pageUrl))).blob();
+    if (!blob.size) return null;
+    return (await sha256(blob)) !== (await fallbackHash)
+      ? chromeFaviconUrl(pageUrl)
+      : null;
+  } catch {
+    return null;
+  }
+}
+
+async function candidates(pageUrl: string): Promise<string[]> {
+  const u = new URL(pageUrl);
+  if (u.protocol !== 'http:' && u.protocol !== 'https:') return [];
+
+  const list: string[] = [];
+  const fromChrome = await chromeIcon(pageUrl);
+  if (fromChrome) list.push(fromChrome);
+
+  if (isLocalHost(u.hostname)) {
+    list.push(`${u.origin}/favicon.ico`);
+  } else {
+    list.push(`https://favicon.vemetric.com/${u.hostname}?size=64`);
+    list.push(`https://icons.duckduckgo.com/ip3/${u.hostname}.ico`);
+  }
+  return list;
+}
+
+export function resolveFavicon(
+  pageUrl: string | undefined,
+  force = false,
+): Promise<string | null> {
+  let host: string;
+  try {
+    host = new URL(pageUrl || '').hostname;
+  } catch {
+    return Promise.resolve(null);
+  }
+  if (!host) return Promise.resolve(null);
+
+  const key = `${host}|${force}`;
+  const running = inflight.get(key);
+  if (running) return running;
+
+  const task = (async () => {
+    if (!force) {
+      const hit = await readEntry(host);
+      if (hit && (hit.learned || Date.now() - hit.ts < TTL)) return hit.src;
+    }
+    for (const src of await candidates(pageUrl as string)) {
+      if (await canLoad(src)) {
+        writeEntry(host, { src, ts: Date.now() });
+        return src;
+      }
+    }
+    return null;
+  })().finally(() => inflight.delete(key));
+
+  inflight.set(key, task);
+  return task;
+}
+
+export function letterIcon(label: string): string {
+  const ch = (label.trim()[0] ?? '?').toUpperCase().replace(/[&<>"']/g, '?');
+  let hue = 0;
+  for (const c of label) hue = (hue * 31 + c.charCodeAt(0)) % 360;
+  const svg =
+    `<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 64 64">` +
+    `<rect width="64" height="64" rx="14" fill="hsl(${hue} 45% 45%)"/>` +
+    `<text x="32" y="43" font-family="Segoe UI,sans-serif" font-size="32" font-weight="600" text-anchor="middle" fill="#fff">${ch}</text>` +
+    `</svg>`;
+  return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
+}
